---
/**
 * LevelPathway: Level 2, Level 3 National, Level 4 HNC, Level 5 HND, then degree top-up or work.
 * The artwork has no text. The four level boxes and the two outcome boxes are filled with real HTML.
 * "Degree top-up or work" is one label in the list. On a wide figure it is split across the two outcome
 * boxes with "or" between them, and in the text list it reads as a single line.
 * The pathway artwork is a thin strip, so the labels switch to a text list below the image
 * under 600px (see the container query in the component styles).
 */
import '../../styles/btec-visuals.css';

interface Props {
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { loading = 'lazy', fetchpriority = 'auto' } = Astro.props;

const levels = [
  { label: 'Level 2', box: { x: 1.44, y: 50.0, w: 12.98, h: 17.7 } },
  { label: 'Level 3 National', box: { x: 17.16, y: 38.03, w: 12.88, h: 17.38 } },
  { label: 'Level 4 HNC', box: { x: 33.46, y: 26.72, w: 12.88, h: 17.54 } },
  { label: 'Level 5 HND', box: { x: 50.24, y: 16.39, w: 12.88, h: 17.21 } },
];
const pos = (b: { x: number; y: number; w: number; h: number }) => `--x:${b.x};--y:${b.y};--w:${b.w};--h:${b.h}`;
---

<figure class="viz viz--pathway">
  <div class="viz__stage">
    <img
      class="viz__img"
      src="/images/btec/btec-level-pathway-level-2-to-level-5.webp"
      width="1200"
      height="352"
      alt="BTEC pathway from Level 2 to Level 3 National to Level 4 HNC to Level 5 HND, leading to a degree top-up or work."
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
    />
    <ol class="viz__labels viz__labels--pathway">
      {levels.map((l) => (
        <li class="viz__label" style={pos(l.box)}>{l.label}</li>
      ))}
      <li class="viz__outcome">
        <span class="viz__label viz__outcome-degree" style={pos({ x: 85.24, y: 5.08, w: 12.98, h: 17.7 })}>Degree top-up</span>
        <span class="viz__or" style={pos({ x: 85.24, y: 40, w: 12.98, h: 14 })}>or</span>
        <span class="viz__label viz__outcome-work" style={pos({ x: 85.24, y: 72.95, w: 12.21, h: 17.7 })}>work</span>
      </li>
    </ol>
  </div>
  <figcaption class="viz__caption">Where each BTEC level sits and what usually comes next.</figcaption>
</figure>

<style>
  /* The outcome item is a single list entry. Narrow: it reads as one line. */
  .viz__outcome .viz__label {
    display: inline;
    position: static;
    padding: 0;
  }
  .viz__outcome .viz__or {
    display: inline;
  }
  .viz__outcome {
    margin: 0.375rem 0;
    padding-left: 0.25rem;
  }

  /* Wide enough for the labels to sit in the artwork's boxes. */
  @container (min-width: 600px) {
    .viz__labels--pathway {
      font-size: clamp(0.6875rem, 1.95cqw, 0.9375rem);
    }
    .viz__outcome {
      display: contents;
    }
    .viz__outcome .viz__label {
      position: absolute;
      display: flex;
    }
    .viz__outcome-work::first-letter,
    .viz__outcome-degree::first-letter {
      text-transform: uppercase;
    }
    .viz__outcome .viz__or {
      position: absolute;
      left: calc(var(--x) * 1%);
      top: calc(var(--y) * 1%);
      width: calc(var(--w) * 1%);
      height: calc(var(--h) * 1%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: var(--viz-ink);
    }
  }
</style>
